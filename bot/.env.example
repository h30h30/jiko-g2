# Required
BOT_TOKEN=123456:your-telegram-bot-token
GROQ_API_KEY=gsk_your-groq-api-key

# Recommended for production (e.g. Neon Postgres)
# Without DATABASE_URL, the bot falls back to local JSON files
DATABASE_URL=

# Optional — Notion integration (shared demo workspace or your own database)
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Optional comma-separated Telegram user IDs or @usernames allowed to access Notion
NOTION_ALLOWED_USERS=

# Optional — Public backend URL passed to pay.html
PUBLIC_API_URL=https://jiko-ob5s.onrender.com

# Optional — Pricing & model overrides
COFFEE_PRICE_USD=5
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Optional — HTTP bind settings
PORT=8787
HOST=0.0.0.0